@inherits LayoutComponentBase
@inject PortfolioService Data

<div class="bg-glow" aria-hidden="true"></div>

<header class="site-header">
    <nav class="container nav">
        <a class="brand" href="?section=top" aria-label="Home">@(_profile?.Initials)</a>
        <div class="nav-links">
            <a href="?section=about">About</a>
            <a href="?section=skills">Skills</a>
            <a href="?section=projects">Projects</a>
            <a href="?section=contact" class="btn btn-small">Contact</a>
        </div>
    </nav>
</header>

<main>
    @Body
</main>

<footer class="site-footer">
    <div class="container">
        <span>© @DateTime.Now.Year @(_profile?.Name)</span>
        <span>Built with Blazor WebAssembly · Hosted on GitHub Pages</span>
    </div>
</footer>

@code {
    private Profile? _profile;

    protected override async Task OnInitializedAsync() =>
        _profile = await Data.GetProfileAsync();
}